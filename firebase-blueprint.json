  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "SafeReach account profiles with 10-character complex Unique ID and admin-controlled subscription access."
    },
    "/users/{userId}/private/{docId}": {
      "schema": "PrivateUserInfo",
      "description": "Owner-only private account info (email, emergency contact label, zero phone numbers)."
    },
    "/directory/{safeReachId}": {
      "schema": "DirectoryEntry",
      "description": "Lookup table mapping 10-character complex Unique IDs to account IDs without exposing PII or location."
    },
    "/familyLinks/{linkId}": {
      "schema": "FamilyLink",
      "description": "Family link requests and approved relationships between traveler and family accounts."
    },
    "/familyAccess/{accessId}": {
      "schema": "FamilyAccess",
      "description": "O(1) traveler-controlled access grant for cross-user live location reads."
    },
    "/users/{userId}/live/{docId}": {
      "schema": "LiveLocationState",
      "description": "Current live GPS state readable only by owner, admin, and approved family when subscribed."
    },
    "/users/{userId}/trips/{tripId}": {
      "schema": "Trip",
      "description": "Planned and active journeys with geofence radius and route polylines."
    },
    "/users/{userId}/history/{entryId}": {
      "schema": "LocationHistoryEntry",
      "description": "Protected personal location history breadcrumbs accessible only to the owner."
    },
    "/familyAlerts/{alertId}": {
      "schema": "FamilyAlert",
      "description": "Real-time arrival, route deviation, and SOS notifications for approved family members."
    },
    "/settings/{docId}": {
      "schema": "GlobalSettings",
      "description": "Global Admin-controlled access settings (All Users Access ON/OFF)."
    }
  }
}
