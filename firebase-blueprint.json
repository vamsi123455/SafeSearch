    "DirectoryEntry": {
      "title": "DirectoryEntry",
      "description": "Lookup mapping a 10-character complex Unique ID to an account ID without exposing PII, phone numbers, or location.",
      "type": "object",
      "properties": {
        "safeReachId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
