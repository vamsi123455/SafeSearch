{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Core SafeReach account profile with 10-character complex unique ID, admin-controlled subscription state, and zero phone PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "safeReachId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[A-Za-z0-9!@#$%^&*\\-_+=~]{10}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rolePreference": {
          "type": "string",
          "enum": ["traveler", "family", "both"]
        },
        "isSharingEnabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "idle",
            "travelling",
            "reached_safely",
            "sos_alert",
            "route_deviation",
            "signal_stale"
          ]
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["pending", "active", "revoked"]
        },
        "accessGranted": {
          "type": "boolean"
        },
        "subscriptionNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "ownerUid",
        "safeReachId",
        "displayName",
        "rolePreference",
        "isSharingEnabled",
        "status",
        "subscriptionStatus",
        "accessGranted",
        "subscriptionNote",
        "createdAt",
        "updatedAt"
      ]
    },
